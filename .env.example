# ── Database ──
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=password
POSTGRES_DB=jobagent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobagent:password@localhost:5432/jobagent

# ── Redis ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Freshness (Backend Enforced) ──
FRESHNESS_HOURS=24
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Experience Ceiling ──
EXPERIENCE_MAX_YEARS=2

# ── Skill-First Matching Weights (Sum = 1.0) ──
WEIGHT_REQUIRED_SKILL_MATCH=0.65
WEIGHT_PREFERRED_SKILL_MATCH=0.10
WEIGHT_TRANSFERABLE_SKILL_MATCH=0.10
WEIGHT_EXPERIENCE_MATCH=0.05
WEIGHT_LOCATION_MATCH=0.05
WEIGHT_PREFERENCE_MATCH=0.05

# ── Local Embeddings ──
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── AI Gateway (OmniRoute - Single Model Gateway) ──
LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:8000/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini
OMNIROUTE_TIMEOUT=45.0
DEFAULT_AGENT_MODEL=gpt-4o-mini

# ── Live Source Adapters ──
SOURCE_SAMPLE_ENABLED=false
SOURCE_INTERNSHALA_ENABLED=true
SOURCE_NAUKRI_ENABLED=true
SOURCE_LINKEDIN_ENABLED=true

# ── Scraper Rate Limits ──
RATE_LIMIT_LINKEDIN_RATE=10
RATE_LIMIT_LINKEDIN_PER=60.0
RATE_LIMIT_NAUKRI_RATE=15
RATE_LIMIT_NAUKRI_PER=60.0
RATE_LIMIT_INTERNSHALA_RATE=20
RATE_LIMIT_INTERNSHALA_PER=60.0

# ── Crawl4AI Infrastructure ──
CRAWL4AI_ENABLED=true
CRAWL4AI_HEADLESS=true
CRAWL4AI_MAX_CONCURRENCY=3
CRAWL4AI_TIMEOUT=20.0

# ── Browser & Scraping Hardening ──
BROWSER_USER_DATA_DIR=~/.config/job_agent_browser_profile
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50

# ── Local Tor SOCKS5 Network Proxy Fallback ──
TOR_PROXY_URL=socks5://127.0.0.1:9050
TOR_ENABLED=true
TOR_FALLBACK_ON_BLOCKED=true

# ── Hermes Agent & MCP Tier ──
HERMES_HOME=~/.hermes
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
