# ── Database ──
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=password
POSTGRES_DB=jobagent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobagent:password@localhost:5432/jobagent

# ── Freshness (Backend Enforced) ──
FRESHNESS_HOURS=24
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Experience ──
EXPERIENCE_MAX_YEARS=2

# ── Search Limits ──
MAX_SEARCH_ITERATIONS=3
MAX_RAW_JOBS_PER_SOURCE=100
MAX_JOBS_FOR_LLM_ANALYSIS=15
TOP_N_RESULTS=10

# ── Matching Weights (Sum = 1.0) ──
WEIGHT_SKILL_MATCH=0.30
WEIGHT_SEMANTIC_SIMILARITY=0.25
WEIGHT_EXPERIENCE_MATCH=0.15
WEIGHT_ROLE_RELEVANCE=0.10
WEIGHT_LOCATION_MATCH=0.10
WEIGHT_PREFERENCE_MATCH=0.10

# ── Embedding ──
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── LLM Provider ──
LLM_PROVIDER=ollama

# ── Ollama (Primary) ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_WINDOW=16384
OLLAMA_TIMEOUT=60.0

# ── OmniRoute / OpenAI Compatible (Fallback) ──
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=auto/best-coding

# ── Source Adapters ──
SOURCE_SAMPLE_ENABLED=false
SOURCE_INTERNSHALA_ENABLED=true
SOURCE_NAUKRI_ENABLED=true
SOURCE_LINKEDIN_ENABLED=true
SOURCE_INSTAHYRE_ENABLED=false

# ── Crawl4AI ──
CRAWL4AI_ENABLED=true
