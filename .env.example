# ── Database ──
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=password
POSTGRES_DB=jobagent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobagent:password@localhost:5432/jobagent

# ── Redis ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Freshness (Backend Enforced) ──
FRESHNESS_HOURS=24
DEFAULT_TIMEZONE=Asia/Kolkata

# ── Experience Ceiling ──
EXPERIENCE_MAX_YEARS=2

# ── Skill-First Matching Weights (Sum = 1.0) ──
WEIGHT_REQUIRED_SKILL_MATCH=0.65
WEIGHT_PREFERRED_SKILL_MATCH=0.10
WEIGHT_TRANSFERABLE_SKILL_MATCH=0.10
WEIGHT_EXPERIENCE_MATCH=0.05
WEIGHT_LOCATION_MATCH=0.05
WEIGHT_PREFERENCE_MATCH=0.05

# ── Local Embeddings ──
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── LLM Provider Selection (ollama | openai | gemini | anthropic | groq | openrouter | cerebras | mistral | nvidia_nim | opencode | openai_compatible | omniroute) ──
LLM_PROVIDER=ollama

# ── Ollama (Primary Local) ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_WINDOW=16384
OLLAMA_TIMEOUT=60.0

# ── Fallback Provider (Optional) ──
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ── Cloud LLM Providers ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Custom / OpenAI Compatible / OpenCode ──
OPENCODE_BASE_URL=http://localhost:4096/v1
OPENCODE_MODEL=opencode-default
OPENCODE_API_KEY=

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=auto/best-fast

# ── Live Source Adapters ──
SOURCE_SAMPLE_ENABLED=false
SOURCE_INTERNSHALA_ENABLED=true
SOURCE_NAUKRI_ENABLED=true
SOURCE_LINKEDIN_ENABLED=true

# ── Scraper Rate Limits ──
RATE_LIMIT_LINKEDIN_RATE=10
RATE_LIMIT_LINKEDIN_PER=60.0
RATE_LIMIT_NAUKRI_RATE=15
RATE_LIMIT_NAUKRI_PER=60.0
RATE_LIMIT_INTERNSHALA_RATE=20
RATE_LIMIT_INTERNSHALA_PER=60.0

# ── Crawl4AI Infrastructure ──
CRAWL4AI_ENABLED=true
CRAWL4AI_HEADLESS=true
CRAWL4AI_MAX_CONCURRENCY=3
CRAWL4AI_TIMEOUT=20.0

# ── Browser & Scraping Hardening ──
BROWSER_USER_DATA_DIR=~/.config/job_agent_browser_profile
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50

# ── Local Tor SOCKS5 Network Proxy Fallback ──
TOR_PROXY_URL=socks5://127.0.0.1:9050
TOR_ENABLED=true
TOR_FALLBACK_ON_BLOCKED=true

# ── Hermes Agent & MCP Tier ──
HERMES_HOME=~/.hermes
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
